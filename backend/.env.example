# VendorVerse Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection String
MONGO_URI=your_mongodb_connection_string

# JWT Secret Key (use a long random string in production)
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key

# Google Gemini API Key (used by the AI copilot)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of allowed CORS origins (frontend URLs)
# CORS_ORIGINS=http://localhost:5500,https://your-frontend.onrender.com

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development
